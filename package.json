{
  "name": "@rakshak/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "R.A.K.S.H.A.K. Counter-UAS Training Simulator — SIH 2026 PS 26247, Ministry of Defence",
  "workspaces": [
    "frontend",
    "backend",
    "simulation-engine",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "proto:compile": "pbjs -t static-module -w es6 shared/schemas/*.proto -o shared/generated/sapient.js",
    "clean": "rimraf **/node_modules **/dist **/.next"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "UNLICENSED",
  "author": "Team RAKSHAK — SIH 2026"
}
