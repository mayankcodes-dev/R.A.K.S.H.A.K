{
  "name": "@rakshak/backend",
  "version": "0.1.0-alpha",
  "description": "R.A.K.S.H.A.K. Counter-UAS Training Simulator — Backend API & Simulation Engine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts",
    "db:migrate": "tsx src/config/migrate.ts",
    "db:seed": "tsx src/config/seed.ts",
    "proto:compile": "pbjs -t static-module -w es6 -o src/generated/sapient.js proto/sapient_v7.proto"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/websocket": "^10.0.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/jwt": "^8.0.1",
    "pg": "^8.12.0",
    "ioredis": "^5.4.1",
    "protobufjs": "^7.3.2",
    "dotenv": "^16.4.5",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.1",
    "zod": "^3.23.8",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.5",
    "vitest": "^2.0.5",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0"
  },
  "keywords": [
    "counter-uas",
    "training-simulator",
    "sapient",
    "ministry-of-defence",
    "sih-2026"
  ],
  "license": "UNLICENSED"
}
